# Duck.Sale only. Never commit filled environment files.
BOAT_API_KEY=
CONTEXT_DEV_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# On Vercel, Gateway uses project OIDC. A key is optional for local use.
AI_GATEWAY_API_KEY=
AI_MODEL=google/gemini-4-hydrogen
# Optional: inspect up to one source image per worker (extra model input).
DUCK_SALE_VISION=false

# Optional missing-photo illustration model, clearly labeled in the UI.
AI_IMAGE_MODEL=bfl/flux-3-image-klein

# Optional licensed commercial city-geocoding key. Free endpoint is noncommercial.
OPEN_METEO_API_KEY=

# Public app origin for Boat workers to acquire shared Context permits.
# Defaults to the Duck.Sale production URL; change for another installation.
DUCK_SALE_APP_URL=https://duck.sale

# Private Mode (no ordinary inference or network fallback)
TRUSTEDROUTER_API_KEY=
# JSON: privateKey, publicKey, endpointIp, endpointPort, address (IPv4/CIDR), dns, expectedExitIp
# Dedicated WireGuard device required. Never commit a populated profile.
DUCK_SALE_PRIVATE_VPN_JSON=

# Standard AI provider: gateway (default) or openai. Private Mode still uses NYTE.
AI_PROVIDER=gateway
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol
OPENAI_IMAGE_MODEL=gpt-image-2.6-flare

# Migration runner only; use your own direct/session-pooler connection string.
POSTGRES_URL_NON_POOLING=

# Optional hosted CLI (prefer a separate ignored .env.hosted.local file).
DUCK_SALE_BACKEND_URL=https://duck.sale
DUCK_SALE_HOSTED_TOKEN=
# Server only: JSON generated by npm run demo:issue. Disabled when blank.
DUCK_SALE_DEMO_ACCESS=
